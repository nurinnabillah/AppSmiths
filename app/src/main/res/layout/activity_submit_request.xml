<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/userpage3"
    android:id="@+id/request"
    tools:context=".RequestsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- App Title -->
        <TextView
            android:id="@+id/tvItemId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/calistoga"
            android:text="Submit Request"
            android:textColor="#000000"
            android:textSize="32sp" />

        <!-- Spinner -->
        <Spinner
            android:id="@+id/spinnerItemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:backgroundTint="@color/black"
            android:popupBackground="@color/white"
            android:textAlignment="center"
            android:elevation="4dp"
            android:layout_marginBottom="20dp"
            android:spinnerMode="dropdown"
            android:theme="@style/Theme.AppCompat.Light" />

        <!-- Address -->
        <EditText
            android:id="@+id/etAddress"
            android:hint="Address"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Date Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:textSize="18sp"
                android:text="Date" />

            <TextView
                android:id="@+id/tvRequestDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:text="YYYY-MM-DD"
                android:textSize="18sp"
                android:paddingStart="8dp" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.35"
                android:text="Pick Date"
                android:backgroundTint="#C6BA8B"
                android:onClick="showDatePickerDialog" />
        </LinearLayout>

        <!-- Notes -->
        <EditText
            android:id="@+id/etNotes"
            android:hint="Additional Notes (Optional)"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/submitBtn"
            android:text="Submit Request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#C6BA8B"
            android:onClick="submitRequest"
            android:layout_marginBottom="16dp" />

        <!-- View List Button -->
        <Button
            android:id="@+id/viewListRequestsBtn"
            android:text="View List of Requests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="requestsListClicked"
            android:backgroundTint="#C6BA8B"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
