<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/adminbg"
    android:padding="15dp">

    <TextView
        android:id="@+id/tvRequestTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/calistoga"
        android:text="Trash Pickup Needed"
        android:textAlignment="center"
        android:layout_marginTop="10dp"
        android:textColor="#333333"
        android:textSize="32sp"/>

    <TextView
        android:id="@+id/tvUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Item Name: "
        android:textSize="18sp"
        android:layout_marginTop="6dp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Address: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes: "
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textColor="#000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etWeightInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingBottom="15dp"
            android:layout_weight="2"
            android:hint="Enter Weight"
            android:inputType="numberDecimal"
            android:padding="15dp"
            android:textColor="#040404"
            android:textSize="18sp"
            android:visibility="visible"/>

        <TextView
            android:id="@+id/tvFinalWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#9E7739"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Calculate"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            android:visibility="visible"/>
    </LinearLayout>


    <TextView
        android:id="@+id/tvCalculatedTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Price: -"
        android:textSize="18sp"
        android:layout_marginTop="6dp"
        android:textColor="#4CAF50"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRequestStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Pending"
        android:textColor="#F44336"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnUpdateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:backgroundTint="#9E7739"
        android:elevation="2dp"
        android:paddingHorizontal="20dp"
        android:text="Mark as Completed"
        android:textColor="#FFFFFF"
        android:clickable="true"
        app:cornerRadius="8dp" />
</LinearLayout>
